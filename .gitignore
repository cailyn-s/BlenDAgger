logs/

# Machine-local folders (symlinks into local storage, outputs, notes, external clones)
/data
/results
/checkpoints
notes/
analysis/results/
# Exploratory code kept out of the release
exploratory/
# Machine-specific paths (template: conf/paths_local.example.yaml) and cluster job scripts
conf/local/
ops/
# Pinned simulator dependencies cloned by setup_sim.sh
third_party/
# Configs, scenes and scripts not used for any result reported in the paper
unreported/
outputs/
.pytest_cache/
diffusion_repo/
eval_local/
eval_composite_results/
queue/

